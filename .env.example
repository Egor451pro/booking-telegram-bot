# Токен от @BotFather
BOT_TOKEN=123456:replace-me

# Telegram ID администраторов через запятую. Узнать свой ID: @userinfobot
ADMIN_IDS=123456789

# Название в приветствии и в Web App
STUDIO_NAME=Студия

# Supabase: Project Settings → Database → Connection string (URI).
# Подойдёт и postgresql:// — приложение само подставит драйвер asyncpg.
# На Render берите Session pooler (IPv4), не прямой IPv6-хост db.*.supabase.co.
DATABASE_URL=postgresql+asyncpg://postgres.projectref:password@aws-0-eu-central-1.pooler.supabase.com:5432/postgres
DB_SSL=true
# false — если локально Windows/антивирус даёт CERTIFICATE_VERIFY_FAILED
DB_SSL_VERIFY=true

# webhook — Render (и другие HTTPS-хостинги). polling — локальная разработка.
MODE=webhook

# Публичный HTTPS-адрес сервиса без хвоста пути. Обязателен при MODE=webhook.
WEBHOOK_BASE_URL=https://your-service.onrender.com
# Случайная длинная строка [A-Za-z0-9_-]. Попадает в путь: /webhook/<WEBHOOK_SECRET>
# и в заголовок X-Telegram-Bot-Api-Secret-Token.
WEBHOOK_SECRET=replace-with-a-long-random-string

# HTTPS-адрес календаря. На том же сервисе: https://your-service.onrender.com/webapp
WEBAPP_URL=https://your-service.onrender.com/webapp

# Тестовый токен платежей из @BotFather → ваш бот → Payments. В токене есть :TEST:
PAYMENT_PROVIDER_TOKEN=

# Render подставляет PORT сам. Локально по умолчанию 8000.
HOST=0.0.0.0
PORT=8000
TIMEZONE=Europe/Moscow

# Сетка расписания. WORK_END не включается: при шаге 30 минут последний старт — 19:30.
WORK_START=10:00
WORK_END=20:00
SLOT_STEP_MINUTES=30
SCHEDULE_DAYS=21

# Сколько минут неоплаченная бронь занимает слот (потом её снимет следующий запрос).
HOLD_MINUTES=15

# --- Локальная разработка (вместо MODE=webhook выше) ---
# MODE=polling
# DATABASE_URL=postgresql+asyncpg://booking:booking@localhost:5432/booking
# DB_SSL=false
# WEBAPP_URL=https://<ваш-cloudflared-туннель>/webapp
